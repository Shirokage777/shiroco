{
  "name": "crossroads-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run cards && next dev --turbopack",
    "build": "npm run cards && vitest run && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run cards && vitest run",
    "cards": "node --env-file-if-exists=.env.local scripts/fetch-cards.mjs",
    "add-user": "node scripts/add-user.mjs"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
